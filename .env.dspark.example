# Two-node DGX Spark configuration. Copy to .env.dspark on BOTH nodes.

# Head-to-worker SSH. Use the high-speed ConnectX address or a hostname that
# resolves to it. Passwordless SSH and Docker access are required.
WORKER_HOST=spark-b
WORKER_SCRIPT_DIR=${HOME}/DeepSeek-V4-Flash-Vision-2x-DGX-Spark

# Distributed rendezvous over ConnectX-7.
MASTER_ADDR=10.100.32.1
MASTER_PORT=25000
VLLM_HOST_IP=10.100.32.1
WORKER_VLLM_HOST_IP=10.100.32.2

# Discover these with ibdev2netdev, ip -br addr, and show_gids. Do not copy
# them blindly if the QSFP cable is connected to a different port pair.
NCCL_IB_HCA=rocep1s0f0,roceP2p1s0f0
NCCL_SOCKET_IFNAME=enp1s0f0np0
TP_SOCKET_IFNAME=enp1s0f0np0
GLOO_SOCKET_IFNAME=enp1s0f0np0
NCCL_IB_GID_INDEX=3
NCCL_CROSS_NIC=1
NCCL_IB_MERGE_NICS=1

# Each node keeps a local checkpoint copy. This is the tested configuration.
HF_CACHE=${HOME}/.cache/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_XET=1

# Exact tested model and runtime pins.
DSPARK_MODEL_OFFICIAL=deepseek-ai/DeepSeek-V4-Flash-Vision-Exp
DSPARK_REVISION=e46e16bf6035c6f317eb2ac7458eb0362926d402
SERVED_MODEL_NAME=deepseek-v4-flash-vision-exp
OFFICIAL_VISION_IMAGE=local/deepseek-v4-flash-vision:vllm-1356635-pr54631-fi-26fabfe-gb10

# One interactive session, native vision, 1M per-request ceiling.
VLLM_HOST=0.0.0.0
VLLM_PORT=8888
OFFICIAL_MAX_MODEL_LEN=1048576
OFFICIAL_GPU_MEMORY_UTILIZATION=0.82
OFFICIAL_MTP_NUM_TOKENS=3
MAX_NUM_BATCHED_TOKENS=8192
LONG_PREFILL_TOKEN_THRESHOLD=1024
# Keep generated kernels across coordinated restarts. Change this namespace
# whenever the pinned vLLM, patch, compiler stack, or GPU architecture changes.
OFFICIAL_RUNTIME_CACHE_ROOT=/cache/huggingface/runtime-cache/vllm-1356635-pr54631-sm121
# Adaptive verification is unsupported by this GB10 indexer path.
OFFICIAL_ADAPTIVE_VERIFICATION=false
VLLM_ADAPTIVE_VERIFICATION_PROFILE_CONTEXT_LEN=131072
VLLM_USE_BREAKABLE_CUDAGRAPH=1

# The cluster supervisor owns both TP ranks. Never let Docker restart one rank
# independently.
DSPARK_RESTART_POLICY=no
DSPARK_SUPERVISOR_POLL_SECONDS=10
DSPARK_SUPERVISOR_FAILURE_THRESHOLD=6
DSPARK_SUPERVISOR_INCIDENT_LIMIT=10

# Optional API authentication. Use the same value on both nodes.
# VLLM_API_KEY=replace-with-a-long-random-value
